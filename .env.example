# 服务（本地单人使用，默认只监听本机）
APP_HOST=127.0.0.1
APP_PORT=19613

# 本地 ComfyUI 地址
COMFYUI_URL=http://127.0.0.1:8188

# 路径
WORKFLOW_FILE=config/workflow.json
WORKFLOWS_MANIFEST=config/workflows.json
DATABASE_FILE=data/app.sqlite3
JOBS_DIR=data/jobs
LOG_DIR=data/logs
SKILL_FILE=data/image-prompt-skill.md

# 工作流中的提示词节点 ID
PROMPT_NODE_ID=2
NEGATIVE_PROMPT_NODE_ID=3

# 提示词
PROMPT_MAX_LENGTH=8000

# 结果保留小时数；过期任务由后台自动清理
RESULT_TTL_HOURS=168
AUTO_DELETE_EXPIRED=1

# 队列与轮询
QUEUE_TIMEOUT_HOURS=24
COMFY_POLL_SECONDS=2
COMFY_REQUEST_TIMEOUT=15
COMFY_STATUS_TIMEOUT=3
COMFY_MISSING_GRACE_SECONDS=1200
COMFY_AUTO_REQUEUE_MAX=3
COMFY_DOWNLOAD_RETRY_MAX=3
